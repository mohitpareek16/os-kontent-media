DATABASE_URL=postgresql+asyncpg://kontent:kontent@db:5432/kontent
JWT_SECRET=change-me-to-a-random-secret
UPLOADS_DIR=/data/uploads
CORS_ORIGINS=["http://localhost:5173","http://localhost"]

# --- Kontent Bot (Phase 3) — see docs/11-ai-chatbot.md ---
# Leave the key empty until an OpenRouter account exists: /api/chat then
# answers 503 with a usable message and the UI says the bot isn't connected,
# rather than offering a chat box that fails on submit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MAX_TOOL_ITERATIONS=6
AI_DAILY_MESSAGE_CAP=50

# --- Web Push (desktop notifications) ---
# One keypair per deployment, generated once and kept: a browser's
# subscription is tied to the public key it was created against, so replacing
# the pair silently unsubscribes everybody who already turned alerts on. Use a
# *different* pair for local development — localhost and production are
# separate origins with separate subscriptions either way, and there is
# nothing to be gained from a dev machine holding the production secret.
#
# Both values are url-safe base64 of the raw bytes, which is what
# `py_vapid.Vapid.from_string` expects. Generate a pair with:
#
#   python - <<'EOF'
#   import base64
#   from cryptography.hazmat.primitives import serialization
#   from cryptography.hazmat.primitives.asymmetric import ec
#   b = lambda raw: base64.urlsafe_b64encode(raw).decode().rstrip("=")
#   k = ec.generate_private_key(ec.SECP256R1())
#   print("VAPID_PUBLIC_KEY=" + b(k.public_key().public_bytes(
#       serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)))
#   print("VAPID_PRIVATE_KEY=" + b(k.private_numbers().private_value.to_bytes(32, "big")))
#   EOF
#
# Left empty, push is simply off: the subscribe endpoints answer 503 with a
# message saying so and the in-app toast keeps working as it does today.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real contact. The push services reject sends without one.
VAPID_SUBJECT=mailto:ops@kontent.media

# --- WhatsApp Cloud API (direct Meta, no BSP) — see docs/13-whatsapp.md ---
# Empty credentials are the normal state until a Meta app exists. The sender
# then skips every message with a reason on the record, the admin routes answer
# 503 with a sentence naming the missing variable, and in-app notifications and
# desktop push carry on untouched — WhatsApp is additive and never the only
# path to anything a deadline depends on.
#
# The token must come from a **System User** (Business Settings -> System Users
# -> Generate token, with whatsapp_business_messaging and
# whatsapp_business_management). A personal user token expires after 60 days and
# the notifications then stop on a Tuesday afternoon with nothing in the log
# that looks like a cause.
WHATSAPP_ACCESS_TOKEN=
# The number messages are sent *from*. Not the WABA id — they are different
# objects and the API takes them in different places.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta signs every webhook with HMAC-SHA256 of the raw body under this secret,
# and that signature is the only thing standing between the public internet and
# an endpoint that can move jobs through the pipeline. With this empty the
# webhook refuses everything rather than trusting everything.
WHATSAPP_APP_SECRET=
# Our own random string, echoed back during Meta's one-time webhook handshake.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=
# Pinned, never floating. Meta ships breaking changes behind version numbers,
# and "whatever is current" is how an integration breaks on a date nobody chose.
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_DEFAULT_LANGUAGE=en
# Used to turn "9876543210" into "919876543210". Staff numbers are typed by a
# human and almost never arrive in E.164 — see services/whatsapp/phone.py for
# what is and is not guessed.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# How often the background pass reconciles template status with Meta and sends
# the date-driven messages. The webhook is what makes status fast; this is what
# makes it true after a missed delivery.
WHATSAPP_RECONCILE_INTERVAL_SECONDS=3600

# --- Forgot-password email (plain SMTP; any provider) ---
# Empty SMTP_HOST = no mail is sent (forgot-password still answers 204 and the
# server logs a warning). FRONTEND_BASE_URL is the public origin the emailed
# reset link points at, e.g. https://ops.kontentmedia.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=Kontent OS <no-reply@kontent.media>
FRONTEND_BASE_URL=http://localhost:5173
