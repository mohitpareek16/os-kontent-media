{
  "manifest_version": 3,
  "name": "Kontent Voice Notes for Frame.io",
  "version": "1.4.0",
  "description": "Record timestamped voice notes while reviewing videos on Frame.io. Notes are stored on your team server and shared with everyone who has the extension.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://app.frame.io/*",
    "https://next.frame.io/*",
    "https://f.io/*",
    "https://ops.kontentmedia.in/*"
  ],
  "optional_host_permissions": ["https://ops.kontentmedia.in/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kontent Voice Notes — Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.frame.io/*",
        "https://next.frame.io/*",
        "https://f.io/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
